# ──────────────────────────────────────────────────────────────
# .env.example — Variables de entorno de referencia
# INSTRUCCIONES:
#   cp .env.example .env
#   Editar .env con valores reales (nunca commitear .env)
# ──────────────────────────────────────────────────────────────

# Base de datos
# - Docker crea la base DB_NAME (fenix_postgrado) la PRIMERA vez que se levanta.
# - El esquema DB_SCHEMA (postgrados) y las tablas los crea Alembic: uv run alembic upgrade head
# - La contraseña tiene que ser la MISMA en DB_PASSWORD y adentro de DATABASE_URL.
# - Si cambiás DB_NAME o DB_PASSWORD después, hay que recrear la base: docker compose down -v
DB_USER=postgrado_user
DB_PASSWORD=cambiar_en_produccion
DB_NAME=fenix_postgrado
DATABASE_URL=postgresql://postgrado_user:cambiar_en_produccion@localhost:5432/fenix_postgrado
DB_SCHEMA=postgrados          # Esquema donde van todas las tablas (no se usa public)

# JWT
JWT_SECRET=cambiar_en_produccion_por_secreto_seguro_de_minimo_32_caracteres
JWT_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

# Storage de archivos
STORAGE_PATH=/var/postgrado-storage
MAX_FILE_SIZE_MB=5

# Email (SMTP)
SMTP_HOST=mailhog          # En desarrollo: usa MailHog. En prod: smtp.utn.edu.ar
SMTP_PORT=1025             # MailHog usa 1025. SMTP real usa 587
SMTP_USER=                 # Solo para producción
SMTP_PASSWORD=             # Solo para producción
EMAIL_FROM=noreply@posgrado.frlp.utn.edu.ar
EMAIL_LOGO_URL=            # URL pública del logo UTN que va en el encabezado de los mails

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

CORS_ORIGINS=http://localhost:5173

# Configuración
NODE_ENV=development       # development | production
PORT=8000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:5173    # para armar links en los mails (ej: planilla de notas)
